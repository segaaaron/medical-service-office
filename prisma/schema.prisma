generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, expiresAt])
}

model Treatment {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  price          Float?
  tag            String?
  imageUrl       String?
  beforeImageUrl String?  @map("before_image_url")
  afterImageUrl  String?  @map("after_image_url")
  active         Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
  @@index([order])
  @@index([active, order])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([createdAt])
}

model Contact {
  id                  String   @id @default(uuid())
  singleton           Boolean  @unique @default(true)
  whatsappNumber      String
  whatsappUrl         String
  phone               String
  instagramUsername   String
  instagramUrl        String
  facebookName        String
  facebookUrl         String
  tiktokUsername      String?
  tiktokUrl           String?
  mondayFridayHours   String
  saturdayHours       String
  sundayStatus        String
  locationDescription String
  latitude            Float?
  longitude           Float?
  mapsUrl             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Footer {
  id               String   @id @default(uuid())
  singleton        Boolean  @unique @default(true)
  doctorName       String?
  specialty        String?
  description      String?
  whatsappUrl      String?
  facebookUrl      String?
  instagramUrl     String?
  tiktokUrl        String?
  facialTreatments Json?
  bodyTreatments   Json?
  officeLinks      Json?
  legalLinks       Json?
  copyrightText    String?
  designedByText   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Home {
  id              String   @id @default(uuid())
  singleton       Boolean  @unique @default(true)
  // Hero
  specialties     String?
  doctorName      String?
  subtitle        String?
  description     String?
  highlightedText String?
  btn1Text        String?
  btn2Text        String?
  stat1Value      String?
  stat1Label      String?
  stat2Value      String?
  stat2Label      String?
  stat3Value      String?
  stat3Label      String?
  // FAQ
  faqSectionLabel String?
  faqTitle        String?
  faqs            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PromoBanner {
  id              String   @id @default(uuid())
  singleton       Boolean  @unique @default(true)
  tag             String?
  badges          String?
  title           String?
  highlightedText String?
  description     String?
  doctorName      String?
  location        String?
  whatsappText    String?
  whatsappUrl     String?
  dismissText     String?
  imageUrl        String?
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ReviewStatus {
  pending
  approved
  deleted
}

enum ReviewInviteStatus {
  pending
  used
  expired
  revoked
}

model Review {
  id              String       @id @default(uuid())
  patientName     String       @map("patient_name") @db.VarChar(100)
  patientLastname String?      @map("patient_lastname") @db.VarChar(100)
  treatment       String?      @db.VarChar(150)
  body            String
  rating          Int          @db.SmallInt
  status          ReviewStatus @default(pending)
  ipHash          String?      @map("ip_hash") @db.VarChar(64)
  inviteId        String?      @map("invite_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  approvedAt      DateTime?    @map("approved_at")
  deletedAt       DateTime?    @map("deleted_at")

  // Invitación de la que nació esta reseña (reviews.invite_id → review_invites.id)
  originInvite ReviewInvite? @relation("ReviewOrigin", fields: [inviteId], references: [id], onDelete: SetNull)
  // Invitación que apunta a esta reseña vía review_invites.review_id
  resultInvite ReviewInvite? @relation("InviteResult")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([status, approvedAt(sort: Desc)])
  @@index([inviteId])
  @@map("reviews")
}

model ReviewInvite {
  id              String             @id @default(uuid())
  token           String             @unique @db.VarChar(64)
  patientName     String             @map("patient_name") @db.VarChar(100)
  patientLastname String             @map("patient_lastname") @db.VarChar(100)
  email           String?            @db.VarChar(150)
  phone           String?            @db.VarChar(20)
  status          ReviewInviteStatus @default(pending)
  reviewId        String?            @unique @map("review_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  expiresAt       DateTime           @map("expires_at")
  usedAt          DateTime?          @map("used_at")

  // Reseña creada a partir de esta invitación (review_invites.review_id → reviews.id)
  review         Review?  @relation("InviteResult", fields: [reviewId], references: [id], onDelete: SetNull)
  // Reseñas que nacieron de esta invitación (back-relation de Review.originInvite)
  createdReviews Review[] @relation("ReviewOrigin")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("review_invites")
}

model AboutUs {
  id                     String   @id @default(uuid())
  singleton              Boolean  @unique @default(true)
  sectionLabel           String?
  doctorName             String?
  descriptionDoc         String?
  imageUrl               String?
  gallery                String[] @default([])
  experienceBadgeValue   String?
  experienceBadgeLabel   String?
  stat1Value             String?
  stat1Label             String?
  stat2Value             String?
  stat2Label             String?
  stat3Value             String?
  stat3Label             String?
  whyChooseUsLabel       String?
  whyChooseUsTitle       String?
  whyChooseUsDescription String?
  feature1Title          String?
  feature1Description    String?
  feature2Title          String?
  feature2Description    String?
  feature3Title          String?
  feature3Description    String?
  feature4Title          String?
  feature4Description    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Registro de errores de backend para debugging. Captura solo 5xx.
// El payload (body/query/params) se almacena SANITIZADO: campos PII redactados.
model ErrorLog {
  id         String   @id @default(uuid())
  statusCode Int      @map("status_code") @db.SmallInt
  name       String?  @db.VarChar(100)
  code       String?  @db.VarChar(50)
  message    String?
  stack      String?
  method     String   @db.VarChar(10)
  path       String
  route      String?  @db.VarChar(255)
  body       Json?
  query      Json?
  params     Json?
  ipHash     String?  @map("ip_hash") @db.VarChar(64)
  userId     String?  @map("user_id") @db.VarChar(64)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([statusCode, createdAt(sort: Desc)])
  @@map("error_logs")
}

/// Contacto capturado por el formulario de la web antes de saltar a WhatsApp.
/// La conversación sigue en WhatsApp; esto es el registro consultable de quién
/// escribió, qué le interesaba y cuándo — antes vivía en una tabla que el
/// frontend intentaba crear por su cuenta y que nunca llegó a existir.
model Lead {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(120)
  phone         String?  @db.VarChar(30)
  treatment     String?  @db.VarChar(150)
  message       String?  @db.VarChar(2000)
  preferredDate String?  @map("preferred_date") @db.VarChar(10)
  source        String   @default("contact-form") @db.VarChar(60)
  ipHash        String?  @map("ip_hash") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("leads")
}
